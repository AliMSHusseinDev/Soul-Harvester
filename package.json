{
  "name": "soul-harvester",
  "version": "0.17.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "node scripts/browser-check.mjs",
    "format": "prettier --write src scripts index.html package.json tsconfig.json README.md",
    "format:check": "prettier --check src scripts index.html package.json tsconfig.json README.md",
    "test:visual": "node scripts/visual-check.mjs",
    "test:polish": "node scripts/polish-check.mjs",
    "test:combat-vfx": "node scripts/combat-vfx-check.mjs",
    "test:world-polish": "node scripts/world-polish-check.mjs",
    "test:handling": "node scripts/handling-check.mjs",
    "bench:ai": "node scripts/ai-benchmark.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright": "^1.56.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
